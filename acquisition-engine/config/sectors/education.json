{
  "key": "education",
  "name": "Eğitim",
  "description": "Özel öğretim kursları, dil kursları, özel eğitim ve rehabilitasyon merkezleri",
  "discovery": {
    "queries": ["özel öğretim kursu", "dil kursu", "özel eğitim ve rehabilitasyon merkezi", "İngilizce kursu", "etüt merkezi"],
    "google_place_types": ["school", "language_school", "tutoring_service"],
    "exclude_name_patterns": ["milli eğitim", "devlet", "belediye", "üniversite"]
  },
  "signals": {
    "no_online_booking":   { "weight": 15, "label": "Online kayıt/randevu formu yok", "evidence_field": "has_online_booking", "expect": false },
    "no_whatsapp_link":    { "weight": 10, "label": "Sitede WhatsApp bağlantısı yok", "evidence_field": "has_whatsapp_link", "expect": false },
    "has_instagram":       { "weight": 10, "label": "Instagram hesabı var", "evidence_field": "has_instagram", "expect": true },
    "low_post_frequency":  { "weight": 10, "label": "Düzensiz sosyal medya paylaşımı (çıkarım)", "evidence_field": "social_posting_irregular", "expect": true, "inference_ok": true },
    "has_website":         { "weight": 5,  "label": "Web sitesi var", "evidence_field": "has_website", "expect": true },
    "many_reviews":        { "weight": 10, "label": "20+ Google yorumu", "evidence_field": "review_count_gte_20", "expect": true },
    "contact_email_found": { "weight": 15, "label": "Kurumsal e-posta bulundu", "evidence_field": "has_public_email", "expect": true },
    "phone_found":         { "weight": 5,  "label": "Telefon bulundu", "evidence_field": "has_phone", "expect": true },
    "seasonal_demand":     { "weight": 10, "label": "Kayıt dönemi yoğunluğu (çıkarım)", "evidence_field": "seasonal_enrollment_pressure", "expect": true, "inference_ok": true },
    "multi_branch":        { "weight": 10, "label": "Birden fazla şube (çıkarım)", "evidence_field": "multi_branch", "expect": true, "inference_ok": true }
  },
  "qualification_threshold": 45,
  "service_preference": ["appointment_lead_management", "whatsapp_ai_assistant", "social_content_automation", "instagram_dm_automation", "custom_ai_automation"],
  "message_angles": {
    "appointment_lead_management": "kayıt dönemi taleplerinin tek yerden toplanması ve kaçan ön kayıtların azaltılması",
    "whatsapp_ai_assistant": "veli sorularına 7/24 anında yanıt ve ön kayıt toplama",
    "social_content_automation": "düzenli, planlı sosyal medya içeriği ile kayıt döneminde görünürlük",
    "instagram_dm_automation": "Instagram'dan gelen kurs/fiyat sorularının otomatik yanıtlanması",
    "custom_ai_automation": "kurs programı, yoklama ve veli bilgilendirme süreçlerinin otomasyonu"
  },
  "compliance": {
    "requires_legal_review_for_campaign": false,
    "collect_health_data": false,
    "special_notes": "Özel eğitim ve rehabilitasyon merkezlerinde öğrenci sağlık/engellilik bilgisi toplanmaz."
  }
}
