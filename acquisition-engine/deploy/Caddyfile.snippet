# Yeni panel için Caddy bloğu — mevcut Caddyfile'a EKLENMEZ, önce incelenir (bkz. docs/KURULUM_VE_DEPLOYMENT.md §4).
# Alan adı KULLANICI tarafından belirlenir: Caddy ortam değişkeni BAYS_ACQ_V1_DOMAIN (örn. acq-v1.bayssystem.com).
# Eski acq.bayssystem.com/review sistemi bu blokla ÇAKIŞMAZ; o site bloğuna dokunulmaz.
# Yalnız /api/*, /webhooks/* ve panel kamuya açılır. /internal/* kamuya KAPALIDIR (403):
# n8n → API bağlantısı Caddy üzerinden değil, özel ağdan yapılır (http://127.0.0.1:4100 veya
# compose.n8n-network.yml ile http://bays-acq-v1-api:4100).
{$BAYS_ACQ_V1_DOMAIN} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:4100
    }
    handle /webhooks/* {
        reverse_proxy 127.0.0.1:4100
    }
    @internal path /internal/*
    handle @internal {
        respond "forbidden" 403
    }
    handle {
        reverse_proxy 127.0.0.1:4200
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
    log {
        output file /var/log/caddy/bays-acq-v1.log
    }
}
