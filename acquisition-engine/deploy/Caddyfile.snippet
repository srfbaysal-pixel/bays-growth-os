# Mevcut Caddyfile'a EKLENECEK blok (mevcut site bloklarını değiştirmeyin).
# acq.bayssystem.com → panel (4200) ve API (4100). HTTPS Caddy tarafından otomatik.
acq.bayssystem.com {
    encode zstd gzip

    # API ve webhook yolları doğrudan API'ye
    handle /api/* {
        reverse_proxy 127.0.0.1:4100
    }
    handle /webhooks/* {
        reverse_proxy 127.0.0.1:4100
    }
    # Ö1: n8n'in çağırdığı iç uçlar. Ağ katmanı: yalnız özel ağlar (loopback, Docker köprüsü, LAN).
    # n8n ana makinede çalışıp alan adı üzerinden çağırıyorsa kaynak IP sunucunun GENEL IP'sidir:
    # bu durumda ya n8n'de BAYS_API_URL=http://127.0.0.1:4100 kullanın (Caddy'yi atlar, önerilen)
    # ya da aşağıdaki listeye sunucunun genel IP'sini ekleyin. Kimlik katmanı (HMAC) API'de ayrıca zorunludur.
    @internal_allowed {
        path /internal/*
        remote_ip private_ranges
    }
    handle @internal_allowed {
        reverse_proxy 127.0.0.1:4100
    }
    @internal_denied path /internal/*
    handle @internal_denied {
        respond "forbidden" 403
    }

    # Geri kalan her şey Next.js paneli
    handle {
        reverse_proxy 127.0.0.1:4200
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
    log {
        output file /var/log/caddy/acq.bayssystem.com.log
    }
}
