[Unit]
Description=BaysSystems Acquisition Panel (Next.js)
After=network.target bays-acq-v1-api.service

[Service]
Type=simple
User=bays
WorkingDirectory=/opt/bays-acq-v1/acquisition-engine/apps/panel
Environment=NODE_ENV=production
Environment=PORT=4200
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
