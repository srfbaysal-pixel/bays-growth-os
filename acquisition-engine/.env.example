# ─────────────────────────────────────────────────────────────────────────────
# BaysSystems Acquisition Engine — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın. Gerçek değerleri ASLA depoya koymayın.
# ─────────────────────────────────────────────────────────────────────────────

# ── Çalışma modu (güvenli varsayılanlar) ─────────────────────────────────────
NODE_ENV=production
# DRY_RUN=true  → hiçbir dış sağlayıcıya gerçek gönderim yapılmaz; her şey loglanır
DRY_RUN=true
# LIVE_OUTREACH_ENABLED=false → onaylı mesajlar bile gönderilmez, manuel görev açılır
LIVE_OUTREACH_ENABLED=false
# Test modunda yalnızca bu alıcılara gönderim yapılır (virgülle ayrılmış)
TEST_RECIPIENTS=test@bayssystem.com
# Sektör/klinik koruması: sağlık verisi toplama kapalı
CLINIC_HEALTH_DATA_COLLECTION=false

# ── Veritabanı (mevcut n8n veritabanından AYRI bir veritabanı kullanın) ──────
DATABASE_URL=postgres://bays_acq:CHANGE_ME@127.0.0.1:5432/bays_acq
# Testler için (vitest) — ayrı, silinebilir bir veritabanı
DATABASE_URL_TEST=postgres://bays_acq:CHANGE_ME@127.0.0.1:5432/bays_acq_test

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4100
# Panel ve API'nin arkasında olduğu kök adres (çerez ayarları için)
PUBLIC_BASE_URL=https://acq.bayssystem.com
# Oturum çerezi imzası (en az 32 rastgele bayt: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
SESSION_TTL_HOURS=72
# n8n ↔ API arası HMAC paylaşılan sır (openssl rand -hex 32)
N8N_SHARED_SECRET=CHANGE_ME_openssl_rand_hex_32
# n8n webhook kök adresi (API'nin n8n'e geri bildirim göndereceği adres, opsiyonel)
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
# Rate limit: dakikada istek
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_15MIN=10

# ── İlk yönetici kullanıcı (seed komutu için) ────────────────────────────────
ADMIN_EMAIL=owner@bayssystem.com
ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# ── Keşif kaynakları ─────────────────────────────────────────────────────────
# google_places | mock | csv
DISCOVERY_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
# Google Places (New) günlük istek üst sınırı (maliyet koruması)
GOOGLE_PLACES_DAILY_LIMIT=200
# Web sitesi tarama (robots.txt'ye saygı, 1 istek/sn)
WEBSITE_FETCH_ENABLED=true
WEBSITE_FETCH_TIMEOUT_MS=8000

# ── AI (taslak, sınıflandırma, çıkarım) ──────────────────────────────────────
# anthropic | mock
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_CALL_LIMIT=500

# ── E-posta gönderimi ────────────────────────────────────────────────────────
# smtp | resend | mock
EMAIL_PROVIDER=mock
EMAIL_FROM_NAME=BaysSystems
EMAIL_FROM_ADDRESS=iletisim@bayssystem.com
# Yanıt eşleştirme için plus-adres: reply+<token>@REPLY_DOMAIN
EMAIL_REPLY_DOMAIN=bayssystem.com
EMAIL_DAILY_QUOTA=50
EMAIL_HOURLY_QUOTA=10
# Kill-switch eşikleri
EMAIL_MAX_BOUNCE_RATE=0.05
EMAIL_MAX_CONSECUTIVE_ERRORS=3
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ── Gelen e-posta (n8n IMAP tetikleyicisi API'ye iletir) ─────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ── WhatsApp Cloud API (yalnızca onaylı şablon; varsayılan kapalı) ───────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Uyumluluk kapıları (hukuki doğrulama tamamlanmadan true yapmayın) ───────
COMPLIANCE_IYS_VERIFIED=false
COMPLIANCE_KVKK_VERIFIED=false
COMPLIANCE_CLINIC_ADVERTISING_VERIFIED=false

# ── Panel (Next.js) ──────────────────────────────────────────────────────────
PANEL_PORT=4200
# Geliştirmede panel /api isteklerini buraya yönlendirir
API_INTERNAL_URL=http://127.0.0.1:4100
