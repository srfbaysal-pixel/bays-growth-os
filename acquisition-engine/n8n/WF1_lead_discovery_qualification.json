        "language": "javaScript",
        "jsCode": "// İstek gövdesini ve zaman damgasını hazırla (imza: HMAC-SHA256(ts + \".\" + body))\nconst payload = { workflow_key: 'wf1_discovery', run_id: 'n8n-' + $execution.id + '-ke-if-err', status: 'failed', error: String($json.error?.message ?? $json.error ?? ($json.errors ?? []).join('; ')).slice(0, 2000) };\nconst body = JSON.stringify(payload);\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn { json: { body, ts, signInput: ts + '.' + body } };"
      }
