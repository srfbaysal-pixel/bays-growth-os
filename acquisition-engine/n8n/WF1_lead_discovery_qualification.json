    {
      "id": "784ae7b4-69df-4d94-857b-a7915b5bb27a",
      "name": "Sektör × şehir planı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Pilot: her sektörde 30 nitelikli işletme. Şehir listesini burada düzenleyin.\nconst sectors = ['education', 'beauty', 'clinic'];\nconst cities = ($env.BAYS_PILOT_CITIES || 'İstanbul,Ankara,İzmir').split(',').map(s => s.trim()).filter(Boolean);\nconst targetPerSector = Number($env.BAYS_TARGET_PER_SECTOR || 30);\nconst items = [];\nfor (const sector_key of sectors) for (const city of cities) items.push({ json: { sector_key, city, target_qualified: targetPerSector, limit_per_query: 20 } });\nreturn items;"
      }
    },
    {
      "id": "01b52f03-83f2-40a7-8ca0-1e7208e584aa",
      "name": "Sırayla işle",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        520,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "649dcd6d-60a7-4210-89d9-4329f8058b4d",
      "name": "Keşif: gövde",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// İstek gövdesini ve zaman damgasını hazırla (imza: HMAC-SHA256(ts + \".\" + body))\nconst payload = { run_id: 'n8n-' + $execution.id + '-' + $json.sector_key + '-' + $json.city, sector_key: $json.sector_key, city: $json.city, limit_per_query: $json.limit_per_query, target_qualified: $json.target_qualified };\nconst body = JSON.stringify(payload);\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn { json: { body, ts, signInput: ts + '.' + body } };"
      }
    },
    {
      "id": "be81d2c5-f73a-4fe2-8c8d-83430f6b876b",
      "name": "Keşif: imza",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signInput }}",
        "secret": "={{ $env.BAYS_N8N_SHARED_SECRET }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      }
    },
    {
      "id": "4e0c56e2-8df3-417e-87fc-ec9056e21612",
      "name": "Keşif: API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BAYS_API_URL }}/internal/wf1/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Bays-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-Bays-Signature",
              "value": "=sha256={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
